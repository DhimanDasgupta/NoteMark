import kotlin.Boolean;

CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt TEXT NOT NULL, -- Store as Unix epoch timestamp (milliseconds)
    lastEditedAt TEXT NOT NULL, -- Store as Unix epoch timestamp (milliseconds)
    uuid TEXT NOT NULL UNIQUE, -- Store the ID for the note in a different column
    synced INTEGER AS Boolean NOT NULL DEFAULT 0, -- 0 for false, 1 for true
    markAsDeleted INTEGER AS Boolean NOT NULL DEFAULT 0,  -- 0 for false, 1 for true

    CHECK (synced IN (0,1)),
    CHECK (markAsDeleted IN (0,1))
);

-- Indexes for common query patterns
CREATE INDEX idx_NoteEntity_id ON NoteEntity(id);
CREATE INDEX idx_NoteEntity_modifiedAt ON NoteEntity(lastEditedAt);


--------------------------------------------------------------------------------
-- Note Queries
--------------------------------------------------------------------------------

-- Get number of total notes
getTotalNoteCount:
SELECT count(*) FROM NoteEntity;

-- Number of notes the list shows. Paired with getNotesFromOffSetWithLimit as the count query of
-- the Paging 3 source, so it has to apply exactly the same markAsDeleted filter as that query.
getVisibleNoteCount:
SELECT count(*) FROM NoteEntity WHERE markAsDeleted = 0;

-- Page of notes for the Paging 3 source. id breaks ties on lastEditedAt so that the total order is
-- deterministic; without it two notes sharing a timestamp can swap between pages and be shown twice
-- or skipped entirely by offset paging.
getNotesFromOffSetWithLimit:
SELECT *
FROM NoteEntity
WHERE markAsDeleted = 0
ORDER BY lastEditedAt DESC, id DESC
LIMIT :limit OFFSET :offset;

-- Get all notes, ordered by modification date (newest first)
getAllNotes:
SELECT *
FROM NoteEntity
WHERE markAsDeleted = 0
ORDER BY lastEditedAt DESC;

-- Get all notes which have local changes to upload. Notes marked as deleted are handled by the
-- delete step of the sync instead, so they are left out here.
getAllNonSyncedNotes:
SELECT *
FROM NoteEntity
WHERE synced = 0 AND markAsDeleted = 0;

-- Every row, including those marked as deleted. Snapshot the sync reconciles the server list against.
getAllNotesForSync:
SELECT *
FROM NoteEntity;

-- Get all notes which are deleted from local by not from Remote, ordered by modification date (newest first)
getAllDeletedNotes:
SELECT *
FROM NoteEntity
WHERE markAsDeleted = 1;

-- Get a specific note by its internal ID
getNoteById:
SELECT *
FROM NoteEntity
WHERE id = :id;

-- Get a specific note by its internal UUID
getNoteByUUID:
SELECT *
FROM NoteEntity
WHERE uuid = :uuid;

-- Insert a new note
-- The 'id' will be auto-generated.
-- 'createdAt' and 'modifiedAt' should be set at the time of insertion.
-- 'uuid' should be generated by your application code.
insertNote:
INSERT OR REPLACE INTO NoteEntity(title, content, createdAt, lastEditedAt, uuid, synced)
VALUES (:title, :content, :createdAt, :lastEditedAt, :uuid, :synced);

-- Update an existing note's title, content, and modifiedAt timestamp
updateNote:
UPDATE NoteEntity
SET
    title = :title,
    content = :content,
    lastEditedAt = :lastEditedAt,
    synced = :synced
WHERE uuid = :uuid;

-- The sync queries below only touch a row whose lastEditedAt still matches the value the sync read,
-- so an edit made while the sync was running is never overwritten, marked synced or deleted.

-- Insert a note that only exists on the server. An existing row with the same uuid is left alone.
insertRemoteNoteIfMissing:
INSERT OR IGNORE INTO NoteEntity(title, content, createdAt, lastEditedAt, uuid, synced)
VALUES (:title, :content, :createdAt, :lastEditedAt, :uuid, 1);

-- Take the server copy of a note that was edited more recently on the server.
replaceWithRemoteNote:
UPDATE NoteEntity
SET
    title = :title,
    content = :content,
    lastEditedAt = :lastEditedAt,
    synced = 1
WHERE uuid = :uuid AND lastEditedAt = :expectedLastEditedAt AND markAsDeleted = 0;

-- Mark a note synced after its upload succeeded.
markSyncedIfUnchanged:
UPDATE NoteEntity
SET
    synced = 1
WHERE uuid = :uuid AND lastEditedAt = :lastEditedAt;

-- Remove a synced note that no longer exists on the server.
deleteSyncedNoteIfUnchanged:
DELETE FROM NoteEntity
WHERE uuid = :uuid AND lastEditedAt = :lastEditedAt AND synced = 1 AND markAsDeleted = 0;

-- Permanently delete a note (use with caution)
deleteNoteByUUID:
DELETE FROM NoteEntity
WHERE uuid = :uuid;

-- Not Permanetly deleted but will be deleted after next sync
markNoteAsDeletedByUUID:
UPDATE NoteEntity
SET
    markAsDeleted = 1
WHERE uuid = :uuid;

-- Permanently delete all notes
deleteAll:
DELETE --
FROM NoteEntity;